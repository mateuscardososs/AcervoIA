# Copy to a private local .env and configure values outside version control.
APP_ENV=development
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
AUTH_SECRET_KEY=

# Local default; Gemini is opt-in and used only by server processes.
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
DEMO_CHAT_PROVIDER=ollama
DEMO_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
WORKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=qwen2.5:3b
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Public demo requires both this environment flag and the database switch.
DEMO_ENABLED=false
DEMO_ACCOUNT_EMAIL=public-demo@example.invalid
DEMO_LOGIN_LIMIT_PER_IP=10
DEMO_QUESTION_LIMIT_PER_IP=5
DEMO_QUESTION_WINDOW_SECONDS=3600
GEMINI_DAILY_CALL_LIMIT=100
DEMO_MAX_QUESTION_CHARS=2000
DEMO_MAX_CONTEXT_CHARS=12000
DEMO_MAX_OUTPUT_TOKENS=700

# Local development uses the filesystem. Production must select private S3 storage.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
COMPOSE_NETWORK_SUBNET=172.30.255.0/24
API_SERVICE_IPV4=172.30.255.2
WEB_PROXY_IPV4=172.30.255.3
FORWARDED_ALLOW_IPS=172.30.255.3
WORKER_SERVICE_IPV4=172.30.255.4
CORS_ALLOWED_ORIGINS=
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=
